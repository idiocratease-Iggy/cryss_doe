/* Global Dark Theme */
QWidget {
    background-color: #1e1e1e;
    color: #ffffff;
    font-family: "Segoe UI", Arial, sans-serif;
}

/* Table styling */
QTableWidget {
    background-color: #2d2d2d;
    gridline_color: #404040;
    border: 1px solid #3c3c3c;
}

QHeaderView::section {
    background-color: #3c3c3c;
    padding: 4px;
    border: 1px solid #444444;
    color: #ffffff;
    font-weight: bold;
}

/* Input widgets */
QLineEdit, QCheckBox {
    padding: 5px;
    color: #ffffff;
}

/* Selection highlight */
QTableWidget::item:selected {
    background-color: #3e4a6b;
}

#title_label {
    font-weight: bold;
    font-size: 16px;
}
